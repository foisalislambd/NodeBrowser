        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/api": {
      "name": "@browsernode/api",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.8.2"
      }
    }
  }
