{
  "name": "browsernode",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "browsernode",
      "version": "0.1.0",
      "workspaces": [
        "packages/api",
        "demo"
      ],
      "engines": {
        "node": ">=20"
      }
