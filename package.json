{
  "name": "nodebrowser-monorepo",
  "private": true,
  "version": "1.2.7",
  "description": "WebContainers alternative — Node.js in the browser via C++/WASM",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/api",
    "demo"
  ],
  "scripts": {
    "build:native": "bash scripts/gen-guest-modules.sh && cmake -S . -B build-native -G Ninja -DBN_WITH_QUICKJS=ON -DBN_BUILD_NATIVE_TESTS=ON && cmake --build build-native && ./build-native/kernel/bn_vfs_test && ./build-native/kernel/bn_node_test && ./build-native/kernel/bn_stdio_test",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:cpp-wasm": "bash scripts/ci-build-cpp-wasm.sh",
    "build:api": "npm run build -w @foisal/nodebrowser",
    "build:demo": "npm run build -w demo",
    "build": "npm run build:wasm && npm run build:api && npm run build:demo",
    "dev": "npm run dev -w demo",
    "preview": "npm run preview -w demo",
    "dev:vite": "npm run dev --prefix demo/templates/vite",
    "build:vite": "npm run build --prefix demo/templates/vite",
    "preview:vite": "npm run preview --prefix demo/templates/vite",
    "dev:next": "npm run dev --prefix demo/templates/next",
    "build:next": "npm run build --prefix demo/templates/next",
    "start:next": "npm run start --prefix demo/templates/next",
    "test": "npm run test -w @foisal/nodebrowser && npm run build:native",
    "test:api": "npm run test -w @foisal/nodebrowser",
    "test:e2e": "npx playwright test --project=chromium",
    "bench": "node scripts/bench.mjs",
    "bakeoff": "node scripts/bakeoff.mjs",
    "lint:docs": "node -e \"for (const f of ['README.md','LICENSE','CONTRIBUTING.md','CODE_OF_CONDUCT.md','SECURITY.md','CHANGELOG.md','GOVERNANCE.md','ROADMAP.md','SUPPORT.md','AUTHORS.md','NOTICE','docs/ARCHITECTURE.md','docs/FAQ.md']) require('fs').accessSync(f)\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foisalislambd/NodeBrowser.git"
  },
  "bugs": {
    "url": "https://github.com/foisalislambd/NodeBrowser/issues"
  },
  "homepage": "https://github.com/foisalislambd/NodeBrowser#readme",
  "keywords": [
    "webcontainers",
    "nodejs",
    "wasm",
    "browser",
    "vfs",
    "quickjs",
    "sandbox",
    "esbuild",
    "nodebrowser"
  ],
  "author": "NodeBrowser contributors"
}
